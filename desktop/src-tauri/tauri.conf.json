{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianshu",
  "version": "2.16.4",
  "identifier": "app.tianshu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build && node ../scripts/pack-native.js && node ../scripts/stage-runtime-deps.js && node scripts/fetch-node-runtime.js && node scripts/fetch-shell-runtime.js && node scripts/codesign-nested.js",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "天枢 · Tianshu",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "resources": {
      "../../dist": "rivet-runtime",
      "resources/node": "node-runtime",
      "resources/shell": "shell-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/huiliyi37/Tianshu-Tui/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5OEEyRjAxNTZGQUU5MjEKUldRaDZmcFdBUytLR2NGUVVzUmlWUE5yUHpJWUZ5QjV3SmptSmkzcjZLNEUvOHZRNDlkb1JTdlgK",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
