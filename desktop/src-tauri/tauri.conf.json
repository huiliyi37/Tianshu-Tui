{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "天枢",
  "version": "0.0.1",
  "identifier": "app.tianshu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build && bash ../scripts/pack-native.sh && node scripts/fetch-node-runtime.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "天枢 · Tianshu",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "resources": {
      "../../dist": "rivet-runtime",
      "resources/node": "node-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://example.com/tianshu-updates.json"],
      "pubkey": "",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
