{
  "name": "赛博朋克",
  "colorScheme": "dark",
  "variables": {
    "--bg": "#05050a",
    "--panel": "#090915",
    "--panel-2": "#0e0e24",
    "--panel-3": "#151538",
    "--border": "#1f1f4d",
    "--border-strong": "#00f0ff",
    "--text": "#00f0ff",
    "--text-strong": "#ffffff",
    "--muted": "#7070a0",
    "--faint": "#3d3d7a",
    "--text-dim": "#525299",
    "--text-secondary": "#85a3ff",
    "--hover": "rgba(0, 240, 255, 0.1)",
    "--bg-elevated": "#0e0e24",
    "--surface-2": "rgba(0, 240, 255, 0.15)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#ff0055",
    "--accent-hover": "#ff3377",
    "--accent-fg": "#ffffff",
    "--accent-soft": "rgba(255, 0, 85, 0.16)",
    "--success": "#00ff66",
    "--success-soft": "rgba(0, 255, 102, 0.14)",
    "--warning": "#ffea00",
    "--warning-soft": "rgba(255, 234, 0, 0.14)",
    "--error": "#ff0055",
    "--error-soft": "rgba(255, 0, 85, 0.14)",
    "--info": "#00f0ff",
    "--info-soft": "rgba(0, 240, 255, 0.14)",
    "--overlay": "rgba(2, 2, 6, 0.8)",
    "--shadow-sm": "0 1px 3px rgba(0, 240, 255, 0.2)",
    "--shadow-md": "0 6px 20px rgba(0, 240, 255, 0.3)",
    "--shadow-lg": "0 16px 48px rgba(0, 240, 255, 0.4), 0 0 20px rgba(255, 0, 85, 0.2)",
    "--canvas-bg": "#030308",
    "--island-bg": "#0c0c1e",
    "--shadow-island": "0 1px 3px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 240, 255, 0.08)",
    "--shadow-float": "0 8px 32px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 240, 255, 0.15)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.3",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.2",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 75%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 60%, transparent)",
    "--compose-surface-shadow": "0 12px 40px color-mix(in oklab, var(--text) 15%, transparent), 0 2px 8px color-mix(in oklab, var(--text) 8%, transparent)",
    "--compose-surface-blur": "24px",
    "--compose-surface-saturation": "1.25",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 90%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.2",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 92%, transparent)",
    "--modal-surface-blur": "24px",
    "--modal-surface-saturation": "1.15"
  }
}
