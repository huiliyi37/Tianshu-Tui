{
  "name": "Codex 暗色",
  "colorScheme": "dark",
  "variables": {
    "--bg": "#1f1f1f",
    "--panel": "#171717",
    "--panel-2": "#262626",
    "--panel-3": "#2e2e2e",
    "--border": "#2e2e2e",
    "--border-strong": "#414141",
    "--text": "#ececec",
    "--text-strong": "#ffffff",
    "--muted": "#8e8e8e",
    "--faint": "#5c5c5c",
    "--text-dim": "#b0b0b0",
    "--text-secondary": "#d9d9d9",
    "--hover": "rgba(255, 255, 255, 0.05)",
    "--bg-elevated": "#2b2b2b",
    "--surface-2": "rgba(255, 255, 255, 0.06)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#5c9dff",
    "--accent-hover": "#82b4ff",
    "--accent-fg": "#0d1420",
    "--accent-soft": "rgba(92, 157, 255, 0.12)",
    "--success": "#3fb68b",
    "--success-soft": "rgba(63, 182, 139, 0.12)",
    "--warning": "#d9a439",
    "--warning-soft": "rgba(217, 164, 57, 0.12)",
    "--error": "#e5645c",
    "--error-soft": "rgba(229, 100, 92, 0.12)",
    "--info": "#5c9dff",
    "--info-soft": "rgba(92, 157, 255, 0.12)",
    "--overlay": "rgba(0, 0, 0, 0.55)",
    "--shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.16)",
    "--shadow-md": "0 2px 8px rgba(0, 0, 0, 0.22)",
    "--shadow-lg": "0 8px 20px rgba(0, 0, 0, 0.3)",
    "--canvas-bg": "#141414",
    "--island-bg": "#212121",
    "--shadow-island": "0 1px 2px rgba(0, 0, 0, 0.18), 0 2px 10px rgba(0, 0, 0, 0.12)",
    "--shadow-float": "0 6px 24px rgba(0, 0, 0, 0.35)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.04",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.02",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 80%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 60%, transparent)",
    "--compose-surface-shadow": "0 8px 32px color-mix(in oklab, var(--text) 6%, transparent), 0 2px 6px color-mix(in oklab, var(--text) 3%, transparent)",
    "--compose-surface-blur": "16px",
    "--compose-surface-saturation": "1.04",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 92%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.04",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 95%, transparent)",
    "--modal-surface-blur": "24px",
    "--modal-surface-saturation": "1.02"
  }
}
