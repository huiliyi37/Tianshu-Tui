{
  "name": "经典亮色",
  "colorScheme": "light",
  "variables": {
    "--bg": "#ffffff",
    "--panel": "#f7f7f8",
    "--panel-2": "#f0f0f2",
    "--panel-3": "#e8e8ec",
    "--border": "#e3e3e8",
    "--border-strong": "#d2d2da",
    "--text": "#111116",
    "--text-strong": "#05050a",
    "--muted": "#55555f",
    "--faint": "#9a9aa6",
    "--text-dim": "#8a8a96",
    "--text-secondary": "#5c5c68",
    "--hover": "rgba(0, 0, 0, 0.05)",
    "--bg-elevated": "#f0f0f2",
    "--surface-2": "rgba(127, 127, 127, 0.12)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#7c4dff",
    "--accent-hover": "#6a3df0",
    "--accent-fg": "#ffffff",
    "--accent-soft": "rgba(124, 77, 255, 0.12)",
    "--success": "#1a7f37",
    "--success-soft": "rgba(26, 127, 55, 0.12)",
    "--warning": "#9a6700",
    "--warning-soft": "rgba(154, 103, 0, 0.12)",
    "--error": "#cf222e",
    "--error-soft": "rgba(207, 34, 46, 0.10)",
    "--info": "#0969da",
    "--info-soft": "rgba(9, 105, 218, 0.10)",
    "--overlay": "rgba(20, 20, 28, 0.40)",
    "--shadow-sm": "0 1px 2px rgba(20, 20, 40, 0.08)",
    "--shadow-md": "0 6px 20px rgba(20, 20, 40, 0.12)",
    "--shadow-lg": "0 16px 48px rgba(20, 20, 40, 0.16)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.1",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.05",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 88%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 70%, transparent)",
    "--compose-surface-shadow": "0 12px 40px color-mix(in oklab, var(--text) 10%, transparent), 0 2px 8px color-mix(in oklab, var(--text) 5%, transparent)",
    "--compose-surface-blur": "16px",
    "--compose-surface-saturation": "1.08",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 95%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.06",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 96%, transparent)",
    "--modal-surface-blur": "24px",
    "--modal-surface-saturation": "1.04",
    "--link": "#5c35cc",
    "--link-hover": "#4a25a8",
    "--muted": "#3a3a44",
    "--faint": "#6e6e78",
    "--text-dim": "#5c5c68"
  }
}
