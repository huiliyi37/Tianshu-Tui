{
  "name": "Codex 亮色",
  "colorScheme": "light",
  "variables": {
    "--bg": "#ffffff",
    "--panel": "#f7f7f8",
    "--panel-2": "#efeff1",
    "--panel-3": "#e6e6e9",
    "--border": "#e4e4e7",
    "--border-strong": "#cfcfd4",
    "--text": "#27272a",
    "--text-strong": "#111113",
    "--muted": "#71717a",
    "--faint": "#c4c4ca",
    "--text-dim": "#8c8c94",
    "--text-secondary": "#3f3f46",
    "--hover": "rgba(17, 17, 19, 0.04)",
    "--bg-elevated": "#ffffff",
    "--surface-2": "rgba(17, 17, 19, 0.05)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#1a6fe8",
    "--accent-hover": "#0f5bc7",
    "--accent-fg": "#ffffff",
    "--accent-soft": "rgba(26, 111, 232, 0.09)",
    "--success": "#188a5e",
    "--success-soft": "rgba(24, 138, 94, 0.1)",
    "--warning": "#b07d18",
    "--warning-soft": "rgba(176, 125, 24, 0.1)",
    "--error": "#d1403a",
    "--error-soft": "rgba(209, 64, 58, 0.09)",
    "--info": "#1a6fe8",
    "--info-soft": "rgba(26, 111, 232, 0.09)",
    "--overlay": "rgba(17, 17, 19, 0.4)",
    "--shadow-sm": "0 1px 2px rgba(17, 17, 19, 0.05)",
    "--shadow-md": "0 2px 8px rgba(17, 17, 19, 0.07)",
    "--shadow-lg": "0 8px 20px rgba(17, 17, 19, 0.1)",
    "--canvas-bg": "#f2f2f4",
    "--island-bg": "#ffffff",
    "--shadow-island": "0 1px 2px rgba(17, 17, 19, 0.04), 0 2px 10px rgba(17, 17, 19, 0.04)",
    "--shadow-float": "0 6px 24px rgba(17, 17, 19, 0.12)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.06",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.03",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 84%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 65%, transparent)",
    "--compose-surface-shadow": "0 8px 32px color-mix(in oklab, var(--text) 6%, transparent), 0 2px 6px color-mix(in oklab, var(--text) 3%, transparent)",
    "--compose-surface-blur": "20px",
    "--compose-surface-saturation": "1.05",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 94%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.04",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 95%, transparent)",
    "--modal-surface-blur": "24px",
    "--modal-surface-saturation": "1.02"
  }
}
