{
  "name": "默认亮色",
  "colorScheme": "light",
  "variables": {
    "--bg": "#faf8f5",
    "--panel": "#f4f1eb",
    "--panel-2": "#ebe7df",
    "--panel-3": "#e2ddd3",
    "--border": "#dfd9ce",
    "--border-strong": "#d0c8b9",
    "--text": "#2c2a29",
    "--text-strong": "#1c1a19",
    "--muted": "#65605c",
    "--faint": "#c5beb3",
    "--text-dim": "#7d7772",
    "--text-secondary": "#484542",
    "--hover": "rgba(44, 42, 41, 0.05)",
    "--bg-elevated": "#ffffff",
    "--surface-2": "rgba(44, 42, 41, 0.07)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#b08a5b",
    "--accent-hover": "#957147",
    "--accent-fg": "#ffffff",
    "--accent-soft": "rgba(176, 138, 91, 0.1)",
    "--success": "#629e84",
    "--success-soft": "rgba(98, 158, 132, 0.1)",
    "--warning": "#c9923b",
    "--warning-soft": "rgba(201, 146, 59, 0.1)",
    "--error": "#b95b54",
    "--error-soft": "rgba(185, 91, 84, 0.1)",
    "--info": "#527aa6",
    "--info-soft": "rgba(82, 122, 166, 0.1)",
    "--overlay": "rgba(28, 26, 25, 0.4)",
    "--shadow-sm": "0 1px 2px rgba(44, 42, 41, 0.04)",
    "--shadow-md": "0 4px 12px rgba(44, 42, 41, 0.06)",
    "--shadow-lg": "0 12px 24px rgba(44, 42, 41, 0.1)",
    "--canvas-bg": "#ece8e1",
    "--island-bg": "#faf8f5",
    "--shadow-island": "0 1px 2px rgba(44, 42, 41, 0.03), 0 4px 14px rgba(44, 42, 41, 0.04)",
    "--shadow-float": "0 8px 32px rgba(44, 42, 41, 0.1)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.1",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.05",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 82%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 65%, transparent)",
    "--compose-surface-shadow": "0 12px 40px color-mix(in oklab, var(--text) 8%, transparent), 0 2px 8px color-mix(in oklab, var(--text) 4%, transparent)",
    "--compose-surface-blur": "24px",
    "--compose-surface-saturation": "1.08",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 94%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.06",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 95%, transparent)",
    "--modal-surface-blur": "28px",
    "--modal-surface-saturation": "1.04"
  }
}
