{
  "name": "樱花粉",
  "colorScheme": "light",
  "variables": {
    "--bg": "#fff5f5",
    "--panel": "#ffe3e3",
    "--panel-2": "#ffd0d0",
    "--panel-3": "#ffb3b3",
    "--border": "#ffccd5",
    "--border-strong": "#ff85a1",
    "--text": "#4a1c24",
    "--text-strong": "#2b0a10",
    "--muted": "#8c5b65",
    "--faint": "#c99aa3",
    "--text-dim": "#b5838d",
    "--text-secondary": "#6b3f48",
    "--hover": "rgba(255, 117, 143, 0.08)",
    "--bg-elevated": "#ffd0d0",
    "--surface-2": "rgba(255, 117, 143, 0.12)",
    "--link": "var(--accent)",
    "--link-hover": "var(--accent-hover)",
    "--green": "var(--success)",
    "--accent": "#ff4d6d",
    "--accent-hover": "#ff758f",
    "--accent-fg": "#ffffff",
    "--accent-soft": "rgba(255, 77, 109, 0.12)",
    "--success": "#2d6a4f",
    "--success-soft": "rgba(45, 106, 79, 0.12)",
    "--warning": "#d97706",
    "--warning-soft": "rgba(217, 119, 6, 0.12)",
    "--error": "#e63946",
    "--error-soft": "rgba(230, 57, 70, 0.10)",
    "--info": "#457b9d",
    "--info-soft": "rgba(69, 123, 157, 0.10)",
    "--overlay": "rgba(43, 10, 16, 0.35)",
    "--shadow-sm": "0 1px 2px rgba(255, 117, 143, 0.08)",
    "--shadow-md": "0 6px 20px rgba(255, 117, 143, 0.12)",
    "--shadow-lg": "0 16px 48px rgba(255, 117, 143, 0.16)",
    "--canvas-bg": "#ffe4e7",
    "--island-bg": "#fffafa",
    "--shadow-island": "0 1px 2px rgba(255, 117, 143, 0.08), 0 4px 14px rgba(255, 117, 143, 0.10)",
    "--shadow-float": "0 8px 32px rgba(255, 117, 143, 0.20)"
  },
  "surfaces": {
    "--sidebar-surface-bg": "var(--panel)",
    "--sidebar-surface-blur": "0px",
    "--sidebar-surface-saturation": "1",
    "--main-surface-bg": "var(--bg)",
    "--main-surface-blur": "0px",
    "--main-surface-saturation": "1",
    "--compose-surface-bg": "var(--panel-2)",
    "--compose-surface-border": "var(--border)",
    "--compose-surface-shadow": "var(--shadow-sm)",
    "--compose-surface-blur": "0px",
    "--compose-surface-saturation": "1",
    "--popup-surface-bg": "var(--panel-2)",
    "--popup-surface-blur": "0px",
    "--popup-surface-saturation": "1",
    "--modal-surface-bg": "var(--panel)",
    "--modal-surface-blur": "0px",
    "--modal-surface-saturation": "1"
  },
  "glass": {
    "--sidebar-surface-bg": "color-mix(in oklab, var(--bg) var(--sidebar-glass-opacity), transparent)",
    "--sidebar-surface-blur": "var(--sidebar-glass-blur)",
    "--sidebar-surface-saturation": "1.15",
    "--main-surface-bg": "color-mix(in oklab, var(--bg) var(--main-glass-opacity), transparent)",
    "--main-surface-blur": "var(--main-glass-blur)",
    "--main-surface-saturation": "1.08",
    "--compose-surface-bg": "color-mix(in oklab, var(--panel-2) 85%, transparent)",
    "--compose-surface-border": "color-mix(in oklab, var(--border) 70%, transparent)",
    "--compose-surface-shadow": "0 12px 40px color-mix(in oklab, var(--text) 10%, transparent), 0 2px 8px color-mix(in oklab, var(--text) 5%, transparent)",
    "--compose-surface-blur": "16px",
    "--compose-surface-saturation": "1.12",
    "--popup-surface-bg": "color-mix(in oklab, var(--panel-2) 92%, transparent)",
    "--popup-surface-blur": "20px",
    "--popup-surface-saturation": "1.10",
    "--modal-surface-bg": "color-mix(in oklab, var(--panel) 94%, transparent)",
    "--modal-surface-blur": "24px",
    "--modal-surface-saturation": "1.08"
  }
}
