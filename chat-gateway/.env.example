# Rivet sidecar endpoint
copyRIVET_BASE_URL=http://127.0.0.1:41421
RIVET_TOKEN=your-rivet-sidecar-token
RIVET_CWD=/path/to/your/project

# Gateway binding
PORT=7373
HOST=0.0.0.0
# Public HTTPS URL that WeChat/Feishu webhooks reach
PUBLIC_URL=https://your-gateway.example.com

# Feishu bot credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_ENCRYPT_KEY=xxx
FEISHU_VERIFICATION_TOKEN=xxx

# WeChat official account credentials
WECHAT_APP_ID=wx_xxx
WECHAT_APP_SECRET=xxx
WECHAT_TOKEN=your-wechat-token
WECHAT_ENCODING_AES_KEY=xxx
WECHAT_KIND=official
