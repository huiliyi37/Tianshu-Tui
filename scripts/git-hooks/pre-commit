#!/usr/bin/env bash
# Pre-commit gate — desktop Tauri ACL contract.
#
# Any change to the command registry (src-tauri/src/lib.rs generate_handler!)
# or the ACL permission/capability files must keep
# src-tauri/permissions/custom-commands.toml's allow list in sync, or packaged
# builds silently reject the new command ("not allowed by ACL" — the frontend
# .catch swallows it and the feature quietly dies). Same-family incidents:
# 2026-08-09 (7e674f823, perf settings) and 2026-09-04 (bc1babee3, pty
# backpressure, fixed in 3de847238) — the contract test existed both times;
# it only helps if it runs before the commit lands.
#
# Scoped by design: only runs when staged files touch the ACL surface
# (~0.5s when triggered, ~0s otherwise). Kept cheap so nobody reaches for
# --no-verify out of habit (same philosophy as pre-push).
#
# Bypass in a genuine emergency:   git commit --no-verify
# Disable everywhere (e.g. in CI): RIVET_SKIP_HOOKS=1
set -euo pipefail

if [ "${RIVET_SKIP_HOOKS:-}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Staged files touching the ACL contract surface. Debug override (e.g. to test
# the hook without touching the index):
#   RIVET_PRECOMMIT_STAGED_OVERRIDE="desktop/src-tauri/src/lib.rs" git commit …
if [ -n "${RIVET_PRECOMMIT_STAGED_OVERRIDE:-}" ]; then
  staged="$RIVET_PRECOMMIT_STAGED_OVERRIDE"
else
  staged="$(git diff --cached --name-only)"
fi

acl_surface='^desktop/src-tauri/src/lib\.rs$|^desktop/src-tauri/permissions/|^desktop/src-tauri/capabilities/|^desktop/src/lib/__tests__/tauri-acl-contract\.test\.ts$'
if ! printf '%s\n' "$staged" | grep -Eq "$acl_surface"; then
  exit 0
fi

echo "[pre-commit] ACL surface changed — running tauri ACL contract test …"
output="$(
  cd desktop \
    && node --import tsx --test-force-exit --test-timeout=120000 \
      --test 'src/lib/__tests__/tauri-acl-contract.test.ts' 2>&1
)" || {
  echo "$output"
  echo ""
  echo "[pre-commit] ✗ ACL contract broken — commit aborted."
  echo "           generate_handler! 注册的每个命令必须同步登记到"
  echo "           desktop/src-tauri/permissions/custom-commands.toml"
  echo "           （Tauri v2 打包版默认拒绝未登记命令，前端 .catch 静默吞错）。"
  echo "           Bypass: git commit --no-verify"
  exit 1
}
echo "[pre-commit] ACL contract OK."
