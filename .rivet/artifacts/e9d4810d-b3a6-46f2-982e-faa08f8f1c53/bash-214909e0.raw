 86 │     const timer = setTimeout(resolve, ms)
 87 │     const onAbort = () => {
 88 │       clearTimeout(timer)
 89 │       reject(new DOMException('Aborted', 'AbortError'))
 90 │     }
 91 │     signal?.addEventListener('abort', onAbort, { once: true })
 92 │   })
 93 │ }
